// rydb 骨架冒烟：页缓存创建 / 读写 / 越界保护 / 命中缺失统计
导入 "../源/配置.心";
导入 "../源/页缓存.心";

函数 (条件: 整数, 名称: 字符串)断言 {
    如果 (条件 ?= 1) {
        ("[OK]   ")打印;
        (名称)打印;
    } 否则 {
        ("[FAIL] ")打印;
        (名称)打印;
        (1)退出进程;
    }
}

函数 主程序 {
    ("=== rydb 骨架冒烟 ===")打印;

    (页数)页缓存新建 = 缓;
    ("页缓存句柄=")打印;
    (缓)打印;

    (缓)页缓存页数 = 总页;
    (总页 ?= 页数, "页数按配置初始化")断言;

    (缓, 0, 0, 12345)页写 = 写结果;
    (写结果 ?= 0, "页 0 偏移 0 写入成功")断言;

    (缓, 0, 0)页读 = 回读;
    (回读 ?= 12345, "页 0 偏移 0 回读一致")断言;

    (缓, 0, 1023, 777)页写 = 边写;
    (边写 ?= 0, "页末槽写入成功")断言;

    0 - 1 = 负一;

    (缓, 0, 1024, 1)页写 = 越界写;
    (越界写 ?= 负一, "越过页尾写入返回 -1")断言;

    (缓, 99, 0, 1)页写 = 越页写;
    (越页写 ?= 负一, "越页号写入返回 -1")断言;

    (缓, 0, 5)页访问 = 首访;
    (缓, 0, 6)页访问 = 再访;

    (缓)页缓存缺失 = 缺失;
    (缓)页缓存命中 = 命中;
    (缺失 ?= 1, "首次访问计入缺失一次")断言;
    (命中 ?= 1, "同页再次访问计入命中一次")断言;

    (缓, 0)页版本 = 版本;
    ("页 0 版本=")打印;
    (版本)打印;

    (缓)页缓存写次 = 写次数;
    ("写次数=")打印;
    (写次数)打印;

    ("=== rydb 骨架通过 ===")打印;
}
