// rydb 配置：页存储骨架
// 共享内存以 32 位整数槽为粒度；1 页 = 4 KiB = 1024 槽。
// 字节级读写待接入日月内置 `取字节/存字节` 后再细化，骨架先用整数字槽。

1024 = 页槽数;
8 = 页数;

// 页缓存上下文槽布局
//   0 页数  1 数据池句柄  2 命中数  3 缺失数  4 写次数  5 元数据起始槽
0 = 缓页数;
1 = 缓数据池;
2 = 缓命中;
3 = 缓缺失;
4 = 缓写数;
5 = 缓元基;

// 每页元数据 2 槽：状态 / 版本号（写一次 +1）
2 = 页元槽宽;
0 = 页未加载;
1 = 页已加载;
