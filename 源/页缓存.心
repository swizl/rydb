// rydb 存储层骨架：定长页缓存 + 页元数据 + 命中/缺失统计
// 后续里程碑（B+ 树、记录编解码、事务）在此之上实现。

// 新建页缓存，返回上下文句柄
函数 (页数量: 整数)页缓存新建(0 = 结果: 整数) {
    (页数量 * 页槽数)共享新建 = 数据池;
    (页数量 * 页元槽宽 + 6)共享新建 = 结果;
    (结果, 缓页数, 页数量)共享存整数;
    (结果, 缓数据池, 数据池)共享存整数;
    (结果, 缓命中, 0)共享存整数;
    (结果, 缓缺失, 0)共享存整数;
    (结果, 缓写数, 0)共享存整数;
    (结果, 缓元基, 6)共享存整数;
}

函数 (缓: 整数)页缓存页数(0 = 结果: 整数) {
    (缓, 缓页数)共享取整数 = 结果;
}

// 页号 / 偏移是否合法
函数 (缓: 整数, 页号: 整数, 偏移: 整数)页内合法(0 = 结果: 整数) {
    0 = 结果;
    (缓, 缓页数)共享取整数 = 总页;
    如果 (页号 >= 0) {
        如果 (页号 < 总页) {
            如果 (偏移 >= 0) {
                如果 (偏移 < 页槽数) {
                    1 = 结果;
                }
            }
        }
    }
}

// 写一个整数槽；返回 0 成功，-1 越界
函数 (缓: 整数, 页号: 整数, 偏移: 整数, 值: 整数)页写(0 = 结果: 整数) {
    0 - 1 = 结果;
    (缓, 页号, 偏移)页内合法 = 合法;
    如果 (合法 ?= 1) {
        (缓, 缓数据池)共享取整数 = 池;
        页号 * 页槽数 + 偏移 = 位;
        (池, 位, 值)共享存整数;
        (缓, 缓写数)共享取整数 = 写次;
        (缓, 缓写数, 写次 + 1)共享存整数;
        6 + 页号 * 页元槽宽 + 1 = 版槽;
        (缓, 版槽)共享取整数 = 版次;
        (缓, 版槽, 版次 + 1)共享存整数;
        0 = 结果;
    }
}

// 读一个整数槽；越界返回 0（调用方应先判 页内合法）
函数 (缓: 整数, 页号: 整数, 偏移: 整数)页读(0 = 结果: 整数) {
    0 = 结果;
    (缓, 页号, 偏移)页内合法 = 合法;
    如果 (合法 ?= 1) {
        (缓, 缓数据池)共享取整数 = 池;
        页号 * 页槽数 + 偏移 = 位;
        (池, 位)共享取整数 = 结果;
    }
}

// 读取并记一次命中 / 缺失（首次访问某页计入缺失）
函数 (缓: 整数, 页号: 整数, 偏移: 整数)页访问(0 = 结果: 整数) {
    6 + 页号 * 页元槽宽 = 态槽;
    (缓, 态槽)共享取整数 = 态;
    如果 (态 ?= 页已加载) {
        (缓, 缓命中)共享取整数 = 命中次;
        (缓, 缓命中, 命中次 + 1)共享存整数;
    } 否则 {
        (缓, 缓缺失)共享取整数 = 缺失次;
        (缓, 缓缺失, 缺失次 + 1)共享存整数;
        (缓, 态槽, 页已加载)共享存整数;
    }
    (缓, 页号, 偏移)页读 = 结果;
}

函数 (缓: 整数)页缓存命中(0 = 结果: 整数) {
    (缓, 缓命中)共享取整数 = 结果;
}

函数 (缓: 整数)页缓存缺失(0 = 结果: 整数) {
    (缓, 缓缺失)共享取整数 = 结果;
}

函数 (缓: 整数)页缓存写次(0 = 结果: 整数) {
    (缓, 缓写数)共享取整数 = 结果;
}

// 页版本号：每次成功写入 +1，可用于后续脏页判定
函数 (缓: 整数, 页号: 整数)页版本(0 = 结果: 整数) {
    6 + 页号 * 页元槽宽 + 1 = 版槽;
    (缓, 版槽)共享取整数 = 结果;
}
